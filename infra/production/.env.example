# Production Environment Variables
NODE_ENV=production

# Backend API URL (production)
NEXT_PUBLIC_API_URL=https://api.vaxen.com
BACKEND_BASE_URL=https://api.vaxen.com

# Backend API Paths
BACKEND_REQUEST_ACCESS_PATH=/api/request-access
BACKEND_FAQS_PATH=/api/landing/faqs
BACKEND_BENEFITS_PATH=/api/landing/benefits
BACKEND_HOW_IT_WORKS_PATH=/api/landing/how-it-works
BACKEND_DASHBOARD_PATH=/api/dashboard/summary

# Security & Performance
# SESSION_SECRET=
# JWT_SECRET=

# Monitoring & Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Rate Limiting
RATE_LIMIT=5
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=info

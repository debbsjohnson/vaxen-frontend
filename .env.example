# --- vaxen-frontend env ---

# Core API base URL. Used by all Next.js Route Handlers (server-side).
# Override per-environment; defaults to http://localhost:9090 if unset.
BACKEND_API_URL=http://localhost:8080

# Supabase (server-side use — Route Handlers only)
# Run `supabase status` to read these. The publishable key replaces the
# old "anon" key in modern Supabase CLI; we use it from the server to
# satisfy GoTrue's `apikey` header.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: only set if you want a route handler to expose the URL to
# the browser (e.g. for a client-side Supabase SDK call). Not required
# for the password-grant sign-in we use today.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Development Environment Variables
NODE_ENV=development

# Backend API URL (adjust to your local backend)
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_BASE_URL=http://host.docker.internal:8080

# Backend API Paths
BACKEND_REQUEST_ACCESS_PATH=/api/request-access
BACKEND_FAQS_PATH=/api/landing/faqs
BACKEND_BENEFITS_PATH=/api/landing/benefits
BACKEND_HOW_IT_WORKS_PATH=/api/landing/how-it-works
BACKEND_DASHBOARD_PATH=/api/dashboard/summary

# Docker settings
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
